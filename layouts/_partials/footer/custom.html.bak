<script src="/pagefind/pagefind-ui.js"></script>

<div id="mw-search-modal">
    <div id="mw-search-box">
        <button id="mw-search-close">Close</button>
        <div id="search"></div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const menu = document.querySelector(".menu");

    if (menu) {
        const button = document.createElement("button");
        button.id = "mw-search-button";
        button.innerHTML = `
            <span class="mw-search-left">
                <svg class="mw-search-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10.5 18a7.5 7.5 0 1 1 5.3-12.8A7.5 7.5 0 0 1 10.5 18Zm0-2a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm6.4.5 4.3 4.3-1.4 1.4-4.3-4.3 1.4-1.4Z"></path>
                </svg>
                <span>Search</span>
            </span>
            <span class="mw-search-shortcut">Ctrl+K</span>
        `;
        menu.prepend(button);
    }

    const modal = document.getElementById("mw-search-modal");
    const close = document.getElementById("mw-search-close");

    function initPagefind() {
        if (window.PagefindUI && !document.querySelector(".pagefind-ui")) {
            new PagefindUI({
                element: "#search",
                showSubResults: true,
                showImages: false,
                excerptLength: 30
            });
        }
    }

    function focusSearchInput() {
        setTimeout(function () {
            const input = document.querySelector(".pagefind-ui__search-input");
            if (input) input.focus();
        }, 150);
    }

    function addResultMetadata() {
        document.querySelectorAll(".pagefind-ui__result").forEach(function (result) {
            if (result.querySelector(".mw-result-meta")) return;

            const link = result.querySelector("a");
            if (!link) return;

            let type = "Page";
            const href = link.getAttribute("href") || "";

            if (href.includes("/walkthroughs/")) type = "Walkthrough";
            if (href.includes("/blog/")) type = "Blog";
            if (href.includes("/whoami/")) type = "About";

            const meta = document.createElement("div");
            meta.className = "mw-result-meta";
            meta.textContent = type;

            const title = result.querySelector(".pagefind-ui__result-title");
            if (title) title.insertAdjacentElement("afterend", meta);
        });
    }

    function openSearch() {
        modal.style.display = "block";
        initPagefind();
        focusSearchInput();
        setTimeout(addResultMetadata, 300);
    }

    function closeSearch() {
        modal.style.display = "none";
    }

    document.addEventListener("click", function (e) {
        if (e.target.closest("#mw-search-button")) openSearch();
        if (e.target.id === "mw-search-close") closeSearch();
        if (e.target === modal) closeSearch();

        setTimeout(addResultMetadata, 300);
    });

    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && modal.style.display === "block") {
            closeSearch();
        }

        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            modal.style.display === "block" ? closeSearch() : openSearch();
        }

        setTimeout(addResultMetadata, 300);
    });

    initPagefind();
});
</script>
